# Which model writes the answers. Leave unset and the app auto-detects:
# Gemini if GEMINI_API_KEY is present, else Claude, else extractive mode
# (the policy passage quoted verbatim, no API needed).
# LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# An alias is deliberate. Pinned versions get retired: gemini-2.5-flash
# already returns 404 "no longer available to new users".
GEMINI_MODEL=gemini-flash-latest

# Optional alternative provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Branding (defaults live in app/config.py)
# COMPANY_NAME=SKonnect Industry
